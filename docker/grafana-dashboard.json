{
  "title": "Scavengarr",
  "uid": "scavengarr",
  "description": "Stremio answers, plugin searches, hoster resolutions, HLS proxy and resources (docs/features/observability.md).",
  "tags": [
    "scavengarr"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(scavengarr_build_info, job)",
          "refId": "job"
        },
        "definition": "label_values(scavengarr_build_info, job)",
        "refresh": 1,
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Stremio answers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Answers",
      "description": "Stremio stream requests answered in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(scavengarr_stremio_request_total{job=\"$job\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Version",
      "description": "Running Scavengarr version.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "scavengarr_build_info{job=\"$job\"}",
          "legendFormat": "{{version}}",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Why answers went out",
      "description": "target: resolve_target_count hosters had a video; done: search and resolutions finished; deadline: stream_deadline_seconds; cached: answered from the caches.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (increase(scavengarr_stremio_phase_total{job=\"$job\", phase=\"resolve\"}[$__range]))",
          "legendFormat": "{{outcome}}",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      }
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Search state",
      "description": "cache: fresh cache entry; stale: stale entry, refreshed in the background; search: new search; joined: the title's search was running; none: ended before the search.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (source) (increase(scavengarr_stremio_request_total{job=\"$job\"}[$__range]))",
          "legendFormat": "{{source}}",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Streams per answer (median)",
      "description": "Median streams per answer in the selected range (bucket bounds 0, 1, 2, 3, 5, 8, 13, 21, 34).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(scavengarr_stremio_streams_bucket{job=\"$job\"}[$__range])))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Answer time by search state (p50, p95, 1 h)",
      "description": "Time from the request to the answer, over the last hour at each point.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true,
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(scavengarr_stremio_request_seconds_bucket{job=\"$job\"}[1h])))",
          "legendFormat": "p95 {{source}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, source) (rate(scavengarr_stremio_request_seconds_bucket{job=\"$job\"}[1h])))",
          "legendFormat": "p50 {{source}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Phases (p95, 1 h)",
      "description": "metadata: plugin selection and TMDB titles; search: the shared search (all plugins); resolve: resolution until the answer; background_resolve: the other links of a cached answer.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true,
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(scavengarr_stremio_phase_seconds_bucket{job=\"$job\"}[1h])))",
          "legendFormat": "{{phase}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Plugins",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Search time per plugin (p95, range)",
      "description": "95th percentile of each plugin's search time in the selected range; the search ends 30 s after the request.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, plugin) (increase(scavengarr_plugin_search_seconds_bucket{job=\"$job\"}[$__range])))",
          "legendFormat": "{{plugin}}",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Plugin outcomes (range)",
      "description": "hits, empty, error, cut (search deadline or shutdown); without a run: breaker_open, skipped (no slot before the deadline), unreachable (failed health check).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (plugin, outcome) (increase(scavengarr_plugin_search_total{job=\"$job\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "outcome",
            "rowField": "plugin",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 18
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Results per plugin (range)",
      "description": "Validated results per plugin in the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (plugin) (increase(scavengarr_plugin_results_total{job=\"$job\"}[$__range]))",
          "legendFormat": "{{plugin}}",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Hoster resolutions",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "table",
      "title": "Resolver outcomes (range)",
      "description": "stream, dead, unplayable, timeout, network_error, http_error, error, cut; without a run: cached, breaker_open. direct: content-type probes of URLs without a resolver.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (resolver, outcome) (increase(scavengarr_hoster_resolve_total{job=\"$job\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "outcome",
            "rowField": "resolver",
            "valueField": "Value",
            "emptyValue": "zero"
          }
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 37
      }
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Resolve time per resolver (p95, range)",
      "description": "95th percentile of each resolver's time in the selected range; a resolution gets 15 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, resolver) (increase(scavengarr_hoster_resolve_seconds_bucket{job=\"$job\"}[$__range])))",
          "legendFormat": "{{resolver}}",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 37
      }
    },
    {
      "id": 16,
      "type": "table",
      "title": "Open circuit breakers",
      "description": "Breakers that are open or half-open now; plugin breakers are keyed plugin:category.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "scavengarr_circuit_breaker_open{job=\"$job\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "breaker": 0,
              "name": 1,
              "state": 2
            }
          }
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 47
      }
    },
    {
      "id": 17,
      "type": "row",
      "title": "HLS proxy",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 53
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Throughput",
      "description": "Bytes the HLS proxy sent per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "spanNulls": true,
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (rate(scavengarr_hls_proxy_bytes_total{job=\"$job\"}[5m]))",
          "legendFormat": "{{kind}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 54
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Time to first byte (p95, 5 min)",
      "description": "Time until the proxy's answer starts: for segments the CDN's time to first byte.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": true,
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(scavengarr_hls_proxy_seconds_bucket{job=\"$job\"}[5m])))",
          "legendFormat": "{{kind}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 54
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Answers by status",
      "description": "403 on master: a streaming server's converter was refused (stremio.allow_hls_transcoding off).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "spanNulls": true,
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind, outcome) (rate(scavengarr_hls_proxy_total{job=\"$job\"}[5m]))",
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 54
      }
    },
    {
      "id": 21,
      "type": "row",
      "title": "Resources",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 62
      },
      "panels": []
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "CPU",
      "description": "Cores in use: the whole container (cgroup v2), the Python process, and the rest (Chromium, its driver, Xvfb, health checks).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "spanNulls": true,
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
