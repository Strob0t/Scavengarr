# Production Dockerfile for Scavengarr
# Multi-stage build: install deps → install Patchright Chromium → slim runtime
#
# Built by .github/workflows/image.yml (ghcr.io/strob0t/scavengarr), or:
# Build:  docker build -f Dockerfile.prod -t scavengarr .
# Run:    docker run -p 7979:7979 -v ./data:/app/config scavengarr
# The image bundles the plugins (-v ./plugins:/app/plugins replaces them)

# ── Stage 1: Install Python deps ─────────────────────────────────────────────
FROM python:3.14-slim AS builder

RUN pip install --no-cache-dir poetry && \
    poetry config virtualenvs.in-project true

WORKDIR /app
COPY pyproject.toml poetry.lock ./
RUN poetry install --only main --no-interaction --no-root

COPY src/ src/
RUN poetry install --only main --no-interaction

# ── Stage 2: Install Patchright Chromium ─────────────────────────────────────
FROM python:3.14-slim AS browsers

COPY --from=builder /app /app
WORKDIR /app

# Chromium system dependencies + Patchright Chromium
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 \
    libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    libatspi2.0-0 libxshmfence1 \
    wget ca-certificates fonts-liberation && \
    /app/.venv/bin/python -m patchright install chromium && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# ── Stage 3: Which build runs ────────────────────────────────────────────────
# docker/build_info.py records the commit and the build time in
# src/scavengarr/build_info.json (scavengarr_build_info, /api/v1/healthz and
# the startup log report them). The commit: the build argument (the image
# workflow passes it; --build-arg SCAVENGARR_COMMIT=$(git rev-parse HEAD)),
# else the checkout's .git/HEAD and refs, which .dockerignore lets through
# (.git* matches them when present and .gitignore anyway, so the COPY has a
# source either way). The time: SCAVENGARR_BUILT or the clock. A stage of
# its own keeps the git files out of the runtime image. A rebuild of the
# same commit without arguments reuses this stage's cache, time included.
FROM python:3.14-slim AS buildinfo

ARG SCAVENGARR_COMMIT=
ARG SCAVENGARR_BUILT=
WORKDIR /ctx
COPY docker/build_info.py pyproject.toml .git* ./
RUN python build_info.py --git /ctx --out /build_info.json

# ── Stage 4: Production runtime ──────────────────────────────────────────────
FROM python:3.14-slim

# Runtime deps for Playwright Chromium
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 \
    libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    libatspi2.0-0 libxshmfence1 \
    fonts-liberation curl xvfb && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN useradd --create-home --shell /bin/bash scavengarr
WORKDIR /app

# Venv, app and Playwright browsers, owned by the app's user. COPY --chown,
# not a later `chown -R`: that stores every file again in a layer of its own
COPY --from=browsers --chown=scavengarr:scavengarr /app/.venv /app/.venv
COPY --from=browsers --chown=scavengarr:scavengarr /app/src /app/src
COPY --from=browsers --chown=scavengarr:scavengarr /root/.cache/ms-playwright /home/scavengarr/.cache/ms-playwright

# The entrypoint seeds /app/config/config.yaml from the default beside it
# when the directory holds none (a volume over /app/config hides the image's
# files). /tmp/.X11-unix must exist up front: the non-root Xvfb cannot
# create it
COPY data/config.yaml /app/config.default.yaml
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN mkdir -p /app/config /app/cache /tmp/.X11-unix && \
    chmod 1777 /tmp/.X11-unix && \
    chmod 755 /app/entrypoint.sh && \
    chown scavengarr:scavengarr /app /app/config /app/cache /home/scavengarr/.cache

# The plugins, last: they change most often. A mount over /app/plugins
# replaces them
COPY --chown=scavengarr:scavengarr plugins/ /app/plugins/

# The build's commit and time, where build_identity() reads them
COPY --from=buildinfo --chown=scavengarr:scavengarr /build_info.json /app/src/scavengarr/build_info.json

USER scavengarr

# Environment defaults
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    SCAVENGARR_ENVIRONMENT=prod \
    SCAVENGARR_CONFIG=/app/config/config.yaml \
    SCAVENGARR_LOG_LEVEL=INFO \
    SCAVENGARR_LOG_FORMAT=json \
    SCAVENGARR_PLUGIN_DIR=/app/plugins \
    SCAVENGARR_CACHE_DIR=/app/cache \
    SCAVENGARR_PLAYWRIGHT_HEADLESS=false \
    HOST=0.0.0.0 \
    PORT=7979

# The build arguments as image labels (empty without them; the app reads
# build_info.json). Late in the file: a new value rebuilds no layer above.
ARG SCAVENGARR_COMMIT=
ARG SCAVENGARR_BUILT=
LABEL org.opencontainers.image.source="https://github.com/Strob0t/Scavengarr" \
      org.opencontainers.image.revision="${SCAVENGARR_COMMIT}" \
      org.opencontainers.image.created="${SCAVENGARR_BUILT}"

EXPOSE 7979

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:7979/api/v1/healthz || exit 1

# Starts Xvfb (headful browser for Cloudflare Turnstile), then execs the app.
ENTRYPOINT ["/app/entrypoint.sh"]
