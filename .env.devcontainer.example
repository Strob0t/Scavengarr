# Copied to .env.devcontainer (gitignored) on the first container start
# if that file is missing; fill in and rebuild the container.
# GitHub token for git push and gh (repo scope)
GH_TOKEN=
# Git identity for commits made in the container (a GitHub noreply address keeps
# the real one out of the public history)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# Production diagnostics through Portainer's Docker API (scripts/prodctl.py);
# a user with access to the Scavengarr containers only
PORTAINER_URL=
PORTAINER_API_KEY=
# The usage guard (.claude/hooks/usage-guard.sh): the private GitHub repo that
# holds claude/status.json (owner/name), and the time zone the release time is
# also shown in (default UTC)
USAGE_STATUS_REPO=
USAGE_GUARD_TZ=
