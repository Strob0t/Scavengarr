# Copied to .env.devcontainer (gitignored) on the first container start
# if that file is missing; fill in and rebuild the container.
# GitHub token for git push and gh (repo scope)
GH_TOKEN=
# Git identity for commits made in the container (a GitHub noreply address keeps
# the real one out of the public history)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# Production diagnostics through Komodo's read requests (scripts/prodctl.py,
# scripts/komodo.py): Komodo Core's address, such as https://komodo.example:9120
KOMODO_URL=
# A Komodo API key and its secret that may read the scavengarr container
KOMODO_API_KEY=
KOMODO_API_SECRET=
# The production host's server name in Komodo
KOMODO_SERVER=
# Production's public base URL without a path, for /metrics, the stats
# endpoints and the post-deploy check's stream requests
PRODCTL_BASE_URL=
# The usage guard (.claude/hooks/usage-guard.sh): the private GitHub repo that
# holds claude/status.json (owner/name), and the time zone the release time is
# also shown in (default UTC)
USAGE_STATUS_REPO=
USAGE_GUARD_TZ=
