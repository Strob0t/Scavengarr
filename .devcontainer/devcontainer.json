{
  "name": "Scanvengarr MCP Full",
  "build": {
    "dockerfile": "Dockerfile",
    "options": [
      "--network=host"
    ]
  },
  "initializeCommand": "test -f .env.devcontainer || cp .env.devcontainer.example .env.devcontainer",
  "runArgs": [
    "--env-file",
    "${localWorkspaceFolder}/.env.devcontainer"
  ],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [
    7979
  ],
  "postCreateCommand": "mkdir -p ~/continue && if [ -f .continue/config.yaml ]; then cp .continue/config.yaml ~/continue/config.yaml; fi",
  "postStartCommand": "bash .devcontainer/sync-jdownloader.sh || true",
  "postAttachCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "detachhead.basedpyright",
        "redhat.vscode-yaml",
        "Continue.continue",
        "anthropic.claude-code",
        "charliermarsh.ruff"
      ],
      "settings": {
        "dev.containers.mountWaylandSocket": false,
        "dev.containers.dockerCredentialHelper": false
      }
    }
  },
  "remoteUser": "vscode"
}
